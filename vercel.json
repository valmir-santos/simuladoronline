{
  "version": 2,
  "redirects": [
    { "source": "/simulador", "destination": "/produtos#simuladores", "permanent": true },
    { "source": "/simulador-online", "destination": "/", "permanent": true },
    { "source": "/cotador", "destination": "/produtos#simuladores", "permanent": true },
    { "source": "/multicalculo", "destination": "/produtos#simuladores", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/noticias.php", "destination": "/noticias", "permanent": true },
    { "source": "/blog.php", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/news",
      "schedule": "0 11,17 * * *"
    }
  ]
}
